{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aktsmm/ai-trend-radar/schema/trend.schema.json",
  "title": "AI Trend Radar output",
  "type": "object",
  "required": ["generated_at", "window", "trends"],
  "properties": {
    "generated_at": { "type": "string", "format": "date-time" },
    "window": {
      "type": "object",
      "required": ["from", "to"],
      "properties": { "from": { "type": "string" }, "to": { "type": "string" } }
    },
    "source_status": { "type": "object" },
    "x_integration": { "type": "object" },
    "candidates_pool": { "type": "integer" },
    "last_successful_report_at": { "type": "string", "format": "date-time" },
    "baseline": { "type": "object" },
    "pending": { "type": "array", "items": { "type": "object", "required": ["keyword", "reason"] } },
    "leads_unverified": { "type": "array" },
    "official_ledger": { "type": "object" },
    "trends": { "type": "array", "items": { "$ref": "#/$defs/trend" } }
  },
  "$defs": {
    "tag": { "enum": ["models", "local-llm", "hardware", "agents", "vendor", "tools", "research"] },
    "source": {
      "type": "object",
      "required": ["name", "title", "url", "metric", "metric_name"],
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "metric": { "type": "number" },
        "metric_name": { "type": "string" }
      }
    },
    "slide": {
      "type": "object",
      "required": ["title", "diagram_type", "icon", "official_url"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 40 },
        "bullets": { "type": "array", "items": { "type": "string", "maxLength": 140 }, "minItems": 1, "maxItems": 4 },
        "points": {
          "type": "array", "minItems": 3, "maxItems": 4,
          "items": { "type": "object", "required": ["h", "t"], "additionalProperties": false,
                     "properties": { "h": { "type": "string", "maxLength": 10 }, "t": { "type": "string", "maxLength": 110 } } }
        },
        "diagram_type": { "enum": ["stat", "flow", "checklist", "infographic"] },
        "icon": { "enum": ["terminal", "cycle", "plug", "shield", "cloud", "lock", "check", "image", "chip", "spark", "layers"] },
        "official_url": { "type": "string", "pattern": "^https://" },
        "source_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "stat": { "type": "object", "required": ["value", "label"], "properties": { "value": { "type": "string" }, "label": { "type": "string" } } },
        "steps": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 4 }
      },
      "allOf": [
        { "if": { "properties": { "diagram_type": { "const": "stat" } } }, "then": { "required": ["stat"] } },
        { "if": { "properties": { "diagram_type": { "const": "flow" } } }, "then": { "required": ["steps"] } },
        { "if": { "properties": { "diagram_type": { "enum": ["stat", "flow", "checklist"] } } }, "then": { "required": ["bullets"] } },
        { "if": { "properties": { "diagram_type": { "const": "infographic" } } }, "then": { "required": ["stat", "steps", "points"] } }
      ]
    },
    "theme": {
      "description": "A cross-keyword reading of the week: what the items have in common and the likely background. An INTERPRETATION grounded in listed signals, not a fact.",
      "type": "object",
      "required": ["id", "title", "summary", "background", "entities", "signals", "refs", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 40 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 220 },
        "background": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "maxLength": 150 } },
        "entities": { "type": "array", "minItems": 2, "maxItems": 8, "uniqueItems": true, "items": { "type": "string" } },
        "signals": { "type": "array", "minItems": 2, "maxItems": 8,
                     "items": { "type": "object", "required": ["entity", "note"], "additionalProperties": false,
                                "properties": { "entity": { "type": "string" }, "note": { "type": "string", "maxLength": 100 } } } },
        "refs": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "pattern": "^https://" } },
        "confidence": { "enum": ["high", "medium", "low"] }
      }
    },
    "digest": {
      "type": "object",
      "required": ["summary", "why_trending"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 200 }, "minItems": 2, "maxItems": 4 },
        "why_trending": { "type": "string", "minLength": 1, "maxLength": 160 },
        "what_changes": { "type": "array", "items": { "type": "string", "maxLength": 120 }, "maxItems": 3 },
        "benefits": { "type": "array", "items": { "type": "string", "maxLength": 120 }, "maxItems": 3 },
        "caveats": { "type": "array", "items": { "type": "string", "maxLength": 140 }, "maxItems": 3 },
        "audience": { "type": "string", "maxLength": 80 }
      }
    },
    "deck": {
      "description": "deck/1: downloadable 2-slide briefing (overview + impact). refs/sources resolve to verified evidence.",
      "type": "object",
      "required": ["overview", "impact", "sources"],
      "additionalProperties": false,
      "properties": {
        "overview": {
          "type": "object",
          "required": ["takeaway", "stat", "steps", "changes", "facts", "refs"],
          "additionalProperties": false,
          "properties": {
            "takeaway": { "type": "string", "minLength": 1, "maxLength": 110 },
            "stat": { "type": "object", "required": ["value", "label"], "additionalProperties": false,
                      "properties": { "value": { "type": "string", "maxLength": 20 }, "label": { "type": "string", "maxLength": 50 } } },
            "steps": { "type": "array", "items": { "type": "string", "maxLength": 30 }, "minItems": 2, "maxItems": 4 },
            "changes": { "type": "array", "items": { "type": "string", "maxLength": 80 }, "minItems": 2, "maxItems": 3 },
            "facts": { "type": "array", "minItems": 3, "maxItems": 4,
                       "items": { "type": "object", "required": ["k", "v"], "additionalProperties": false,
                                  "properties": { "k": { "type": "string", "maxLength": 10 }, "v": { "type": "string", "maxLength": 36 } } } },
            "refs": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
          }
        },
        "impact": {
          "type": "object",
          "required": ["audience", "benefits", "how_to", "caveats", "terms", "refs"],
          "additionalProperties": false,
          "properties": {
            "audience": { "type": "string", "maxLength": 80 },
            "benefits": { "type": "array", "items": { "type": "string", "maxLength": 90 }, "minItems": 2, "maxItems": 3 },
            "how_to": { "type": "array", "items": { "type": "string", "maxLength": 90 }, "minItems": 2, "maxItems": 4 },
            "caveats": { "type": "array", "items": { "type": "string", "maxLength": 100 }, "minItems": 1, "maxItems": 3 },
            "terms": { "type": "array", "minItems": 2, "maxItems": 4,
                       "items": { "type": "object", "required": ["t", "d"], "additionalProperties": false,
                                  "properties": { "t": { "type": "string", "maxLength": 24 }, "d": { "type": "string", "maxLength": 70 } } } },
            "refs": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
          }
        },
        "sources": {
          "type": "array", "minItems": 1, "maxItems": 4,
          "items": { "type": "object", "required": ["id", "title", "publisher", "url"], "additionalProperties": false,
                     "properties": { "id": { "type": "string", "pattern": "^s[1-4]$" }, "title": { "type": "string", "maxLength": 80 },
                                     "publisher": { "type": "string", "maxLength": 30 }, "url": { "type": "string", "pattern": "^https://" },
                                     "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } } }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["status", "checks"],
      "properties": {
        "status": { "enum": ["verified", "partially_verified", "unverified"] },
        "selection_reason": { "type": "string" },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["mcp_name", "query", "evidence_urls", "retrieved_at"],
            "properties": {
              "mcp_name": { "type": "string" }, "tool": { "type": "string" }, "query": { "type": "string" },
              "evidence_urls": { "type": "array", "items": { "type": "string", "pattern": "^https://" }, "minItems": 1 },
              "evidence_published_at": { "type": ["string", "null"] }, "result": { "type": "string" },
              "retrieved_at": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    "trend": {
      "type": "object",
      "required": ["keyword", "entity_id", "kind", "category", "tags", "score", "primary", "sources", "official_urls", "summary", "slides", "verification"],
      "properties": {
        "verification": { "$ref": "#/$defs/verification" },
        "url_checks": { "type": "object" },
        "rank": { "type": "integer", "minimum": 1 },
        "keyword": { "type": "string", "minLength": 2 },
        "entity_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9\\-]*$" },
        "kind": { "enum": ["model", "release", "product", "paper", "hardware", "repo"] },
        "category": { "enum": ["model", "dev-tool", "local-runtime", "hardware", "research", "github-trending"] },
        "trend_label": { "enum": ["baseline", "rising"] },
        "primary": {
          "type": "object",
          "required": ["url", "published_at", "date_basis", "source_type", "title"],
          "properties": {
            "url": { "type": "string", "pattern": "^https://" },
            "published_at": { "type": ["string", "null"], "format": "date-time" },
            "date_basis": { "enum": ["published", "observed"] },
            "source_type": { "enum": ["announcement", "release_note", "docs", "product_page", "model_card", "paper", "repo", "catalog", "trending"] },
            "title": { "type": "string" },
            "event_id": { "type": ["string", "null"] }
          },
          "if": { "properties": { "date_basis": { "const": "published" } } },
          "then": { "properties": { "published_at": { "type": "string" } } }
        },
        "events": { "type": "array", "items": { "type": "object", "required": ["url", "source_type"] } },
        "related": { "type": "array", "items": { "type": "string" } },
        "resolved_repo": { "type": ["object", "null"] },
        "why": { "type": "object" },
        "velocity": { "type": "object" },
        "tags": { "type": "array", "items": { "$ref": "#/$defs/tag" }, "minItems": 1, "maxItems": 3, "uniqueItems": true },
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "vendor": { "type": ["string", "null"] },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" }, "minItems": 1 },
        "official_urls": { "type": "array", "items": { "type": "string", "pattern": "^https://" } },
        "official_verified": { "type": "boolean" },
        "summary": { "type": "string", "minLength": 1 },
        "slides": { "type": "array", "items": { "$ref": "#/$defs/slide" }, "maxItems": 3 },
        "digest": { "$ref": "#/$defs/digest" },
        "jp_reactions": { "type": "array", "items": { "type": "object", "required": ["site", "title", "url"],
                          "properties": { "site": { "type": "string" }, "title": { "type": "string" }, "url": { "type": "string", "pattern": "^https://" }, "date": { "type": "string" } } } },
        "deck": { "$ref": "#/$defs/deck" },
        "score_breakdown": { "type": "object", "additionalProperties": { "type": "number" } },
        "x_posts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["url", "likes", "reposts", "views"],
            "properties": {
              "url": { "type": "string" }, "author": { "type": "string" }, "text": { "type": "string" },
              "likes": { "type": "integer" }, "reposts": { "type": "integer" }, "views": { "type": "integer" },
              "via": { "enum": ["link", "brave", "watchlist"] }
            }
          }
        }
      }
    }
  }
}
