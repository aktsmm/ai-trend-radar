{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aktsmm/ai-trend-radar/schema/trend.schema.json",
  "title": "AI Trend Radar output",
  "type": "object",
  "required": ["generated_at", "window", "trends"],
  "properties": {
    "generated_at": { "type": "string", "format": "date-time" },
    "window": {
      "type": "object",
      "required": ["from", "to"],
      "properties": { "from": { "type": "string" }, "to": { "type": "string" } }
    },
    "source_status": { "type": "object" },
    "x_integration": { "type": "object" },
    "candidates_pool": { "type": "integer" },
    "last_successful_report_at": { "type": "string", "format": "date-time" },
    "baseline": { "type": "object" },
    "pending": { "type": "array", "items": { "type": "object", "required": ["keyword", "reason"] } },
    "leads_unverified": { "type": "array" },
    "official_ledger": { "type": "object" },
    "trends": { "type": "array", "items": { "$ref": "#/$defs/trend" } }
  },
  "$defs": {
    "tag": { "enum": ["models", "local-llm", "hardware", "agents", "vendor", "tools", "research"] },
    "source": {
      "type": "object",
      "required": ["name", "title", "url", "metric", "metric_name"],
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "metric": { "type": "number" },
        "metric_name": { "type": "string" }
      }
    },
    "slide": {
      "type": "object",
      "required": ["title", "bullets", "diagram_type", "icon", "official_url"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 40 },
        "bullets": { "type": "array", "items": { "type": "string", "maxLength": 140 }, "minItems": 1, "maxItems": 4 },
        "diagram_type": { "enum": ["stat", "flow", "checklist"] },
        "icon": { "enum": ["terminal", "cycle", "plug", "shield", "cloud", "lock", "check", "image", "chip", "spark", "layers"] },
        "official_url": { "type": "string", "pattern": "^https://" },
        "source_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "stat": { "type": "object", "required": ["value", "label"], "properties": { "value": { "type": "string" }, "label": { "type": "string" } } },
        "steps": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 4 }
      },
      "allOf": [
        { "if": { "properties": { "diagram_type": { "const": "stat" } } }, "then": { "required": ["stat"] } },
        { "if": { "properties": { "diagram_type": { "const": "flow" } } }, "then": { "required": ["steps"] } }
      ]
    },
    "verification": {
      "type": "object",
      "required": ["status", "checks"],
      "properties": {
        "status": { "enum": ["verified", "partially_verified", "unverified"] },
        "selection_reason": { "type": "string" },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["mcp_name", "query", "evidence_urls", "retrieved_at"],
            "properties": {
              "mcp_name": { "type": "string" }, "tool": { "type": "string" }, "query": { "type": "string" },
              "evidence_urls": { "type": "array", "items": { "type": "string", "pattern": "^https://" }, "minItems": 1 },
              "evidence_published_at": { "type": ["string", "null"] }, "result": { "type": "string" },
              "retrieved_at": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    "trend": {
      "type": "object",
      "required": ["keyword", "entity_id", "kind", "category", "tags", "score", "primary", "sources", "official_urls", "summary", "slides", "verification"],
      "properties": {
        "verification": { "$ref": "#/$defs/verification" },
        "url_checks": { "type": "object" },
        "rank": { "type": "integer", "minimum": 1 },
        "keyword": { "type": "string", "minLength": 2 },
        "entity_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9\\-]*$" },
        "kind": { "enum": ["model", "release", "product", "paper", "hardware", "repo"] },
        "category": { "enum": ["model", "dev-tool", "local-runtime", "hardware", "research", "github-trending"] },
        "trend_label": { "enum": ["baseline", "rising"] },
        "primary": {
          "type": "object",
          "required": ["url", "published_at", "date_basis", "source_type", "title"],
          "properties": {
            "url": { "type": "string", "pattern": "^https://" },
            "published_at": { "type": ["string", "null"], "format": "date-time" },
            "date_basis": { "enum": ["published", "observed"] },
            "source_type": { "enum": ["announcement", "release_note", "docs", "product_page", "model_card", "paper", "repo", "catalog", "trending"] },
            "title": { "type": "string" },
            "event_id": { "type": ["string", "null"] }
          },
          "if": { "properties": { "date_basis": { "const": "published" } } },
          "then": { "properties": { "published_at": { "type": "string" } } }
        },
        "events": { "type": "array", "items": { "type": "object", "required": ["url", "source_type"] } },
        "related": { "type": "array", "items": { "type": "string" } },
        "resolved_repo": { "type": ["object", "null"] },
        "why": { "type": "object" },
        "velocity": { "type": "object" },
        "tags": { "type": "array", "items": { "$ref": "#/$defs/tag" }, "minItems": 1, "maxItems": 3, "uniqueItems": true },
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "vendor": { "type": ["string", "null"] },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" }, "minItems": 1 },
        "official_urls": { "type": "array", "items": { "type": "string", "pattern": "^https://" } },
        "official_verified": { "type": "boolean" },
        "summary": { "type": "string", "minLength": 1 },
        "slides": { "type": "array", "items": { "$ref": "#/$defs/slide" }, "maxItems": 3 },
        "score_breakdown": { "type": "object", "additionalProperties": { "type": "number" } },
        "x_posts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["url", "likes", "reposts", "views"],
            "properties": {
              "url": { "type": "string" }, "author": { "type": "string" }, "text": { "type": "string" },
              "likes": { "type": "integer" }, "reposts": { "type": "integer" }, "views": { "type": "integer" },
              "via": { "enum": ["link", "brave", "watchlist"] }
            }
          }
        }
      }
    }
  }
}
